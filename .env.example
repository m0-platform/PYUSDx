# Localhost RPC URL
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Mainnet RPC URLs
MAINNET_RPC_URL=
ARBITRUM_RPC_URL=
MONAD_RPC_URL=

# Testnet RPC URLs
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
MONAD_TESTNET_RPC_URL=

# Used for verifying contracts on Etherscan
ETHERSCAN_API_KEY=

MAINNET_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=1"
ARBITRUM_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=42161"
MONAD_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=143"

SEPOLIA_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=11155111"
ARBITRUM_SEPOLIA_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=421614"
MONAD_TESTNET_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=10143"

# ============ DeployAll ============

# Deployer
# Secrets are injected by `op run` (see Makefile). Set this to a 1Password reference, e.g.:
#   PRIVATE_KEY="op://Eng team Accounts/Team ETH account/Private key"
# or a raw 0x-prefixed hex key for local use.
PRIVATE_KEY=

# PYUSDX
PYUSDX_NAME=PYUSDX
PYUSDX_SYMBOL=PYUSDX
PYUSDX_ADMIN=
PYUSDX_PAUSER=
PYUSDX_FREEZE_MANAGER=
PYUSDX_FORCED_TRANSFER_MANAGER=
PYUSDX_EARNER_MANAGER=
PYUSDX_RATE_MANAGER=
PYUSDX_EARNER_MANAGER_RATE_LIMIT_CAPACITY=0
PYUSDX_EARNER_MANAGER_RATE_LIMIT_REFILL=0

# IssuerGateway
ISSUER_GATEWAY_ADMIN=
ISSUER_GATEWAY_OPERATOR=
ISSUER_GATEWAY_EXECUTOR=
ISSUER_GATEWAY_MINT_DELAY=0
ISSUER_GATEWAY_MINT_TTL=86400
ISSUER_GATEWAY_RATE_LIMIT_CAPACITY=0
ISSUER_GATEWAY_RATE_LIMIT_REFILL=0

# SwapFacility
SWAP_FACILITY_ADMIN=
SWAP_FACILITY_PAUSER=

# PYUSDXExtensionFactory
FACTORY_ADMIN=
FACTORY_MANAGER=

# Portal
PORTAL_ADMIN=
PORTAL_PAUSER=
PORTAL_OPERATOR=
PORTAL_FALLBACK_RECIPIENT=
PORTAL_RATE_LIMIT_CAPACITY=0
PORTAL_RATE_LIMIT_REFILL=0

# LayerZeroBridgeAdapter
LAYER_ZERO_ENDPOINT=
LAYER_ZERO_BRIDGE_ADAPTER_ADMIN=
LAYER_ZERO_BRIDGE_ADAPTER_OPERATOR=

# ============ DeployPortalOFTWrapper ============

PORTAL_OFT_WRAPPER_ADMIN=
PORTAL_OFT_WRAPPER_OPERATOR=
# The token the wrapper represents: an Extension address, or empty for the PYUSDX wrapper.
PORTAL_OFT_WRAPPER_TOKEN=

# ============ DeployYieldToOne / DeployMultiMint ============

# Extension common
# EXTENSION_NAME is the internal handle: it seeds the CREATE3 salt and is the key under which
# the deployed address is recorded in deployments/<chainid>.json (NOT the ERC20 name/symbol).
EXTENSION_NAME=

# YieldToOne only (MultiMint reads everything from its JSON config instead — see below)
# EXTENSION_TOKEN_NAME / EXTENSION_TOKEN_SYMBOL are the on-chain ERC20 name and symbol.
EXTENSION_TOKEN_NAME=
EXTENSION_TOKEN_SYMBOL=
ADMIN=
PAUSER=
FREEZE_MANAGER=
VERSION_MANAGER=
YIELD_RECIPIENT=
YIELD_RECIPIENT_MANAGER=

# MultiMint only
# Config lives in deploymentConfigs/<chainid>/<EXTENSION_NAME>.json (schema: deploymentConfigs/README.md).
# EXTENSION_CONFIG=   # optional config file path override

# ============ ConfigureMultiMintAssetCap ============
# Registers/updates a collateral type on a deployed MultiMint extension.
# Resolve the MultiMint address by EXTENSION_NAME (above) from deployments/<chainid>.json, or set MULTI_MINT.
# ASSET_CAP is denominated in ASSET's decimals; 0 disables the asset.
# MULTI_MINT=
# ASSET=
ASSET_CAP=

# ============ Existing deployment addresses (used by extension scripts) ============
# Override if not reading from deployments/{chainId}.json
# PYUSDX=
# ISSUER_GATEWAY=
# SWAP_FACILITY=
# EXTENSION_FACTORY=
# PORTAL=
# LAYER_ZERO_BRIDGE_ADAPTER=
# PYUSDX_PORTAL_OFT_WRAPPER=
